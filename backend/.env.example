# Copy this file to .env and fill in real values. .env is gitignored.

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-real-secret

# Database. Defaults to SQLite at backend/data/users.db if unset.
# Swap to Postgres later: postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=sqlite+aiosqlite:///./data/users.db

# Initial admin account, created on first startup if no admin exists.
# fastapi-users uses email as the login identifier.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Seed test users on first run.
# viewer@example.com / viewer123  (viewer role)
# operator@example.com / operator123  (operator role)
# Set to "false" in production.
SEED_DEV_USERS=true

# --- Data source ----------------------------------------------------------
# Demo mode: serve self-contained mock data (no P06 / MQTT / cps-schema needed).
# Ideal for live demos when other groups aren't publishing real data.
MOCK_DATA=false

# Real mode: all dashboard reads come from P06's (Data Logging) HTTP query API.
P06_API_URL=http://localhost:8088
# POLL_INTERVAL_S=10          # how often to poll P06 for latest values
# ACTIVE_ALERT_WINDOW_MIN=10  # anomaly alerts newer than this count as "active"

# --- MQTT (manual watering command -> P05) --------------------------------
# Only used in real mode for the one write path (the watering button).
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_ENABLED=true           # set false to disable the watering publisher
