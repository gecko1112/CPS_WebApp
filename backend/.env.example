# Copy this file to .env and fill in real values. .env is gitignored.

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-real-secret

# Database. Defaults to SQLite at backend/data/users.db if unset.
# Swap to Postgres later: postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=sqlite+aiosqlite:///./data/users.db

# Initial admin account, created on first startup if no admin exists.
# fastapi-users uses email as the login identifier.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Seed test users on first run.
# viewer@example.com / viewer123  (viewer role)
# operator@example.com / operator123  (operator role)
# Set to "false" in production.
SEED_DEV_USERS=true
